    "custom_css": "\n@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;1,9..144,300&family=Manrope:wght@200;300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap');\n*{box-sizing:border-box;}\n/* ══ FOOTER ══════════════════════════════════════════════════ */\n.d1-footer-section .elementor-icon-list-icon,\n.d1-footer-bottom-section .elementor-icon-list-icon{display:none!important;}\n.d1-footer-section .elementor-icon-list-item,\n.d1-footer-bottom-section .elementor-icon-list-item{padding-left:0!important;}\n.d1-footer-section .elementor-icon-list-text a{\n  color:rgba(235,227,210,.72);text-decoration:none;\n  font-size:14px;transition:color .2s;}\n.d1-footer-section .elementor-icon-list-text a:hover{color:#ebe3d2;}\n.d1-footer-section h5.elementor-heading-title,\n.d1-footer-section .elementor-heading-title[class*=\"h5\"]{color:#5a9d92!important;}\n.d1-footer-brand-logo{font-size:17px;letter-spacing:0.14em;color:#ebe3d2;}\n.d1-footer-bottom-section .elementor-icon-list-items{\n  display:flex;flex-direction:row;gap:20px;}\n.d1-footer-bottom-section .elementor-icon-list-text a{\n  color:rgba(235,227,210,.5);text-decoration:none;font-size:12px;\n  transition:color .2s;}\n.d1-footer-bottom-section .elementor-icon-list-text a:hover{color:#ebe3d2;}\n"
